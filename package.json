{
  "name": "test-nuxt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:test": "nuxt --dotenv .env.development",
    "build:test": "nuxt build  --dotenv .env.production",
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start --dotenv .env.production",
    "generate": "nuxt generate",
    "lint:js": "eslint --ext \".js,.vue\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lintfix": "prettier --write --list-different . && npm run lint:js -- --fix",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,vue}": "eslint --cache",
    "*.**": "prettier --check --ignore-unknown"
  },
  "dependencies": {
    "@nuxt/babel-preset-app": "^2.17.2",
    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/i18n": "^7.3.1",
    "animejs": "^3.2.2",
    "aos": "^3.0.0-beta.6",
    "chart.js": "^2.9.4",
    "core-js": "^2.6.5",
    "dayjs": "^1.11.10",
    "highlight.js": "^11.9.0",
    "less": "^3.13.1",
    "less-loader": "^5.0.0",
    "lodash": "^4.17.21",
    "nuxt": "^2.15.8",
    "nuxt-lazy-load": "^1.3.0",
    "primevue": "^2.10.2",
    "sass": "^1.64.2",
    "sass-loader": "^10.4.1",
    "svgo": "^3.0.2",
    "view-design": "^4.7.0",
    "vue": "^2.7.10",
    "vue-awesome-swiper": "^4.1.1",
    "vue-flatpickr-component": "^8.1.8",
    "vue-i18n": "^8.28.2",
    "vue-server-renderer": "^2.7.10",
    "vue-template-compiler": "^2.7.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.0/xlsx-0.20.0.tgz"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.19.1",
    "@nuxtjs/eslint-config": "^11.0.0",
    "@nuxtjs/eslint-module": "^3.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.24.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-vue": "^9.5.1",
    "html-webpack-plugin": "^4.5.2",
    "husky": "^8.0.1",
    "image-webpack-loader": "^8.1.0",
    "imagemin": "^8.0.1",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-jpegtran": "^7.0.0",
    "imagemin-optipng": "^8.0.0",
    "imagemin-svgo": "^10.0.1",
    "imagemin-webpack-plugin": "^2.4.2",
    "lint-staged": "^13.0.3",
    "nuxt-aos": "^1.2.1",
    "postcss": "^8.4.32",
    "postcss-px-to-viewport-8-plugin": "^1.2.3",
    "postcss-style-px-to-viewport": "^2.9.1",
    "prettier": "^2.7.1",
    "terser-webpack-plugin": "^4.2.3",
    "webpack": "^4.46.0"
  }
}
